powershell -Command "[System.GC]::Collect(); [System.GC]::WaitForPendingFinalizers()" >nul 2>&1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Kernel" /v "DisablePreFetch" /t REG_DWORD /d 1 /f
reg add "HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Kernel" /v "DisableSuperFetch" /t REG_DWORD /d 1 /f

echo [!] REMOVING TELEMETRY AND DATA COLLECTION...
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\DataCollection" /v "AllowTelemetry" /t REG_DWORD /d 0 /f
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\AppCompat" /v "AITEnable" /t REG_DWORD /d 0 /f
reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows\AppCompat" /v "DisableInventory" /t REG_DWORD /d 1 /f
reg add "HKLM\SOFTWARE\Policies\Microsoft\SQMClient\Windows" /v "CEIPEnable" /t REG_DWORD /d 0 /f

echo [!] OPTIMIZING DISK AND STORAGE SPEED...
fsutil behavior set disablelastaccess 1
fsutil behavior set disable8dot3 1
reg add "HKLM\SYSTEM\CurrentControlSet\Control\FileSystem" /v "LongPathsEnabled" /t REG_DWORD /d 1 /f

echo [!] DELETING SYSTEM JUNK FILES...
del /q /f /s "%WINDIR%\Temp\*" >nul 2>&1
del /q /f /s "%WINDIR%\Prefetch\*" >nul 2>&1
del /q /f /s "%SystemDrive%\*.log" >nul 2>&1
del /q /f /s "%SystemDrive%\*.tmp" >nul 2>&1


echo.
echo    Phoenix.optimizer finished optimaztion!
echo    Restart your computer to apply changes!

pause
exit